# === Cyberboss Companion Stack 常驻配置 ===
CYBERBOSS_USER_NAME=你希望TA叫你的名字
CYBERBOSS_USER_GENDER=female
CYBERBOSS_CHANNEL=weixin
CYBERBOSS_RUNTIME=gemini
CYBERBOSS_ENABLE_CHECKIN=true
CYBERBOSS_ENABLE_LATENT_MEMORY=true
CYBERBOSS_WEIXIN_MIN_CHUNK_CHARS=3800

# === Gemini 客户端（agy）配置 ===
CYBERBOSS_GEMINI_COMMAND=agy
CYBERBOSS_GEMINI_MODEL=gemini-4-hydrogen-medium
CYBERBOSS_GEMINI_EFFORT=medium

# === Timeline 时间轴与无头浏览器截图 ===
CYBERBOSS_TIMELINE_PORT=4319

# === Latent 显影 四层长期记忆与山屋端口（仅监听 127.0.0.1，通过 SSH 转发访问） ===
CYBERBOSS_LATENT_PYTHON=python3
CYBERBOSS_LATENT_HUT_PORT=8766

# === 轻量类脑增强开关（赫布联想/梦境巩固、代理层强制注入、AI 独立读报节拍） ===
CYBERBOSS_MEMORY_INJECTION=true
CYBERBOSS_DREAM_ENABLED=true
CYBERBOSS_PRESENCE_NEWSPAPER=true
